# OTA 地址（--ota-url 参数可覆盖）
DEFAULT_OTA_URL=https://ota.zectrix.com/xiaozhi/ota/

# 预设WiFi（编译时注入，避免每次刷机重新配网）
DEFAULT_WIFI_SSID=
DEFAULT_WIFI_PASSWORD=

# 设备签名主密钥：build.sh 会从本文件 export，再透传到 idf.py -DDEVICE_MASTER_KEY=
# 必须与 server/.env 的 MASTER_KEY 完全一致，否则设备 pair-start 会全部 401。
#
# 留空时固件以 REPLACE_ME 占位符编译 —— 固件能启动，但签名永远校验失败、
# 设备无法配对。这不是可接受的默认值，务必先填。
DEVICE_MASTER_KEY=

