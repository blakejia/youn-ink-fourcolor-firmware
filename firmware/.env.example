# OTA 地址（--ota-url 参数可覆盖）
DEFAULT_OTA_URL=https://ota.zectrix.com/xiaozhi/ota/

# 预设WiFi（编译时注入，避免每次刷机重新配网）
DEFAULT_WIFI_SSID=
DEFAULT_WIFI_PASSWORD=

# 设备签名主密钥：必须由 build.sh 传入到 idf.py -DDEVICE_MASTER_KEY=
...
# 与 server/.env 的 MASTER_KEY 保持一致，否则 pair-start 会全部 401。
# build.sh 会 export 该值，release.py 透传到 idf.py -DDEVICE_MASTER_KEY=
...；
DEVICE_MASTER_KEY=

