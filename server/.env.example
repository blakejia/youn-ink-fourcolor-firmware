# ─── OpenAI-compatible API (Whisper ASR + chat/completions LLM + audio/speech TTS) ───
# Any OpenAI-compatible endpoint works (OpenAI, Together, Groq, OpenRouter, local llama.cpp /v1 proxy, ...).
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ASR_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
# OpenAI TTS only emits these PCM formats; 16k/16-bit/mono requires resampling to match device.
OPENAI_TTS_RESPONSE_FORMAT=pcm

# ─── Network ───
LISTEN_HOST=0.0.0.0
LISTEN_PORT=9001               # WebSocket / FastAPI primary port
PUSH_IMAGE_HOST=0.0.0.0
PUSH_IMAGE_PORT=8766           # HTTP image push + OTA + UDP discovery (same port for both UDP/TCP)
# Public hostname the device should dial after discovery (must be reachable from device LAN/WAN).
PUBLIC_WS_URL=wss://your.domain.example.com/ws
PUBLIC_HTTP_BASE=https://your.domain.example.com

# ─── Discovery + device auth ───
# Shared HMAC secret for signing discover_reply. Devices verify with this secret baked into firmware.
# Rotate by setting a new value and re-flashing firmware.
DISCOVERY_SHARED_SECRET=change-me-32-bytes-of-entropy-min
# Service identifier devices expect in discover_host request
DISCOVERY_SERVICE_TAG=youn-ink-v1

# ─── Device signature authentication (pair-start HMAC) ───
# Symmetric key shared with firmware; >=32 random bytes. Server starts but
# rejects ALL pair-start requests while this is empty.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_KEY=
# Comma-separated device_id whitelist; empty = all devices accepted.
ALLOWED_DEVICE_IDS=

# Token for the operator surface (/api/devices, /api/pages, /api/uploads,
# /api/ota, /api/notifications, /mc/*). Empty = those endpoints need no token,
# so set one in production. The server also accepts OPERATOR_TOKEN from the
# process environment (environment wins over this file).
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
OPERATOR_TOKEN=

# ─── Storage ───
DATA_DIR=./data
DEVICES_DB=./data/devices.db
IMAGES_DIR=./data/images
FIRMWARE_DIR=./data/firmware
UPLOADS_DIR=./data/uploads

# ─── Logging ───
LOG_LEVEL=INFO
LOG_DIR=./data
LOG_FILE=server.log

# ─── Audio pipeline ───
# Server-side PCM expected from device: 16 kHz / 16-bit / mono.
DEVICE_SAMPLE_RATE=16000
DEVICE_SAMPLE_WIDTH=2
DEVICE_CHANNELS=1
# PCM chunk size for ASR upload — must match what the firmware sends. 3200 B = 100 ms @ 16 kHz/16-bit.
ASR_CHUNK_BYTES=3200

# ─── Canvas Loop policy ───
# Devices pull a JSON schedule from /api/pages/schedule every poll_interval minutes.
# Sleep window is computed server-side; the device only sees a screen_active boolean.
CANVAS_SLEEP_START=00:00
CANVAS_SLEEP_END=06:00
CANVAS_TIMEZONE=Asia/Shanghai
CANVAS_POLL_INTERVAL_MINUTES=10
CANVAS_SLEEP_POLL_INTERVAL_MINUTES=60
# Floor for per-page duration_minutes (10s SSD2683 refresh → minimum useful 10min).
CANVAS_MIN_PAGE_DURATION_MINUTES=10
